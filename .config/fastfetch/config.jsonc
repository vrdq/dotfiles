{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "separator": " 󰁔 ",
        "color": {
            "keys": "white",
            "title": "white"
        }
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "green",
                "at": "bright_white",
                "host": "white"
            }
        },
        {
            "type": "custom",
            "format": "──────────────────────────────────────────"
        },
        {
            "type": "wm",
            "key": "󰖲 WM"
        },
        {
            "type": "terminal",
            "key": "󰞷 Terminal"
        },
        {
            "type": "shell",
            "key": "󰞷 Shell"
        },
        {
            "type": "font",
            "key": "󰛖 Font"
        },
        {
            "type": "icons",
            "key": "󰀻 Icons"
        },
        {
            "type": "cpu",
            "key": "󰍛 CPU"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU"
        },
        {
            "type": "memory",
            "key": "󰘚 Memory"
        },
        {
            "type": "disk",
            "key": "󰋊 Disk"
        },
        {
            "type": "display",
            "key": "󰍹 Display"
        },
        {
            "type": "battery",
            "key": "󰁹 Battery"
        },
        {
            "type": "custom",
            "format": "──────────────────────────────────────────"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
