#!/usr/bin/env python3
"""
Screen Crosshair Studio
A clean, true-dark desktop control panel for Wayland/Hyprland screen overlay.
"""

import sys
import os
import subprocess
from pathlib import Path

from PyQt6.QtWidgets import (
    QApplication, QWidget, QVBoxLayout, QHBoxLayout, QLabel,
    QPushButton, QSlider, QFrame, QColorDialog
)
from PyQt6.QtGui import (
    QPainter, QColor, QPen, QBrush, QIcon, QPainterPath, QPalette
)
from PyQt6.QtCore import Qt, QRectF, QPointF, QTimer

CONFIG_DIR = Path.home() / ".config" / "crosshair"
CONFIG_FILE = CONFIG_DIR / "config"

DEFAULT_CONFIG = {
    "shape": "dot",
    "size": 6.0,
    "color": "#00FF00",
    "outline": 1.0,
    "outline_color": "#000000",
    "opacity": 1.0,
    "offset_x": 0,
    "offset_y": 0,
    "gap": 3,
    "length": 7,
    "thickness": 2,
    "monitor": "all",
}

PRESETS = {
    "Dot": {"shape": "dot", "size": 6.0, "color": "#00FF00", "outline": 1.0, "offset_x": 0, "offset_y": 0},
    "Micro": {"shape": "dot", "size": 3.0, "color": "#00FF00", "outline": 0.8, "offset_x": 0, "offset_y": 0},
    "Ring": {"shape": "ring", "size": 8.0, "color": "#00FF00", "outline": 1.0, "thickness": 2, "offset_x": 0, "offset_y": 0},
    "Dot+Ring": {"shape": "dot-ring", "size": 10.0, "color": "#00FF00", "outline": 1.0, "thickness": 1, "offset_x": 0, "offset_y": 0},
    "Cross": {"shape": "cross", "size": 12.0, "color": "#00FF00", "outline": 1.0, "gap": 3, "length": 6, "thickness": 2, "offset_x": 0, "offset_y": 0},
    "Cross+Dot": {"shape": "cross-dot", "size": 14.0, "color": "#00FF00", "outline": 1.0, "gap": 4, "length": 7, "thickness": 2, "offset_x": 0, "offset_y": 0},
}

COLOR_SWATCHES = [
    ("#00FF00", "Neon Green"),
    ("#00E5FF", "Cyan"),
    ("#FFE600", "Yellow"),
    ("#FF3333", "Red"),
    ("#FF007F", "Magenta"),
    ("#FFFFFF", "White"),
]


def load_config():
    cfg = dict(DEFAULT_CONFIG)
    if not CONFIG_FILE.exists():
        return cfg
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith(("#", ";")):
                    continue
                if "=" in line:
                    k, v = [part.strip() for part in line.split("=", 1)]
                    k = k.lower()
                    if k in ("size", "outline", "opacity"):
                        cfg[k] = float(v)
                    elif k in ("offset_x", "offset_y", "gap", "length", "thickness"):
                        cfg[k] = int(v)
                    elif k in ("shape", "color", "outline_color", "monitor"):
                        cfg[k] = v
    except Exception as err:
        print(f"Error reading config: {err}", file=sys.stderr)
    return cfg


def save_config(cfg):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    lines = [
        "# Crosshair Overlay Configuration",
        f"shape = {cfg.get('shape', 'dot')}",
        f"size = {cfg.get('size', 6.0):.1f}",
        f"color = {cfg.get('color', '#00FF00')}",
        f"outline = {cfg.get('outline', 1.0):.1f}",
        f"outline_color = {cfg.get('outline_color', '#000000')}",
        f"opacity = {cfg.get('opacity', 1.0):.2f}",
        f"offset_x = {int(cfg.get('offset_x', 0))}",
        f"offset_y = {int(cfg.get('offset_y', 0))}",
        f"gap = {int(cfg.get('gap', 3))}",
        f"length = {int(cfg.get('length', 7))}",
        f"thickness = {int(cfg.get('thickness', 2))}",
        f"monitor = {cfg.get('monitor', 'all')}",
    ]
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")

    subprocess.run(["crosshair", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def get_process_status():
    proc = subprocess.run(["crosshair", "status"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    if proc.returncode == 0 and "PID" in proc.stdout:
        pid = proc.stdout.split("PID")[-1].replace(")", "").strip()
        return True, pid
    return False, None


class ReticleCanvas(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setFixedSize(140, 140)
        self.bg_mode = "dark"
        self.cfg = dict(DEFAULT_CONFIG)

    def set_config(self, cfg):
        self.cfg = dict(cfg)
        self.update()

    def set_bg_mode(self, mode):
        self.bg_mode = mode
        self.update()

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)

        w = self.width()
        h = self.height()
        cx = w / 2.0
        cy = h / 2.0

        path = QPainterPath()
        path.addRoundedRect(QRectF(0, 0, w, h), 8, 8)
        painter.setClipPath(path)

        if self.bg_mode == "dark":
            painter.fillRect(0, 0, w, h, QColor("#08090d"))
        elif self.bg_mode == "light":
            painter.fillRect(0, 0, w, h, QColor("#cbd5e1"))
        elif self.bg_mode == "checker":
            cell = 10
            for row in range(0, h, cell):
                for col in range(0, w, cell):
                    is_even = ((row // cell) + (col // cell)) % 2 == 0
                    painter.fillRect(col, row, cell, cell, QColor("#171a22") if is_even else QColor("#0e1017"))

        # Subtle reference hair-lines
        axis_pen = QPen(QColor(148, 163, 184, 22), 1, Qt.PenStyle.DashLine)
        painter.setPen(axis_pen)
        painter.drawLine(0, int(cy), w, int(cy))
        painter.drawLine(int(cx), 0, int(cx), h)

        shape = self.cfg.get("shape", "dot")
        size = float(self.cfg.get("size", 6.0))
        outline = float(self.cfg.get("outline", 1.0))
        opacity = float(self.cfg.get("opacity", 1.0))
        gap = int(self.cfg.get("gap", 3))
        length = int(self.cfg.get("length", 7))
        thickness = int(self.cfg.get("thickness", 2))

        col = QColor(self.cfg.get("color", "#00FF00"))
        col.setAlphaF(min(1.0, max(0.0, opacity)))

        out_col = QColor(self.cfg.get("outline_color", "#000000"))
        out_col.setAlphaF(min(1.0, max(0.0, 0.85 * opacity)))

        if shape == "dot":
            radius = size / 2.0
            if outline > 0:
                painter.setPen(Qt.PenStyle.NoPen)
                painter.setBrush(QBrush(out_col))
                painter.drawEllipse(QPointF(cx, cy), radius + outline, radius + outline)
            painter.setBrush(QBrush(col))
            painter.drawEllipse(QPointF(cx, cy), radius, radius)

        elif shape == "ring":
            radius = size / 2.0
            th = thickness if thickness else 1.5
            if outline > 0:
                painter.setPen(QPen(out_col, th + outline * 2.0))
                painter.setBrush(Qt.BrushStyle.NoBrush)
                painter.drawEllipse(QPointF(cx, cy), radius, radius)
            painter.setPen(QPen(col, th))
            painter.setBrush(Qt.BrushStyle.NoBrush)
            painter.drawEllipse(QPointF(cx, cy), radius, radius)

        elif shape == "dot-ring":
            radius = size / 2.0
            th = thickness if thickness else 1.5
            if outline > 0:
                painter.setPen(QPen(out_col, th + outline * 2.0))
                painter.setBrush(Qt.BrushStyle.NoBrush)
                painter.drawEllipse(QPointF(cx, cy), radius, radius)
            painter.setPen(QPen(col, th))
            painter.setBrush(Qt.BrushStyle.NoBrush)
            painter.drawEllipse(QPointF(cx, cy), radius, radius)

            dot_r = 1.5
            if outline > 0:
                painter.setPen(Qt.PenStyle.NoPen)
                painter.setBrush(QBrush(out_col))
                painter.drawEllipse(QPointF(cx, cy), dot_r + outline, dot_r + outline)
            painter.setBrush(QBrush(col))
            painter.drawEllipse(QPointF(cx, cy), dot_r, dot_r)

        elif shape in ("cross", "cross-dot"):
            bars = [
                (cx - gap - length, cy - thickness / 2.0, length, thickness),
                (cx + gap, cy - thickness / 2.0, length, thickness),
                (cx - thickness / 2.0, cy - gap - length, thickness, length),
                (cx - thickness / 2.0, cy + gap, thickness, length),
            ]
            if outline > 0:
                painter.setPen(Qt.PenStyle.NoPen)
                painter.setBrush(QBrush(out_col))
                for bx, by, bw, bh in bars:
                    painter.drawRect(QRectF(bx - outline, by - outline, bw + outline * 2.0, bh + outline * 2.0))

            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(QBrush(col))
            for bx, by, bw, bh in bars:
                painter.drawRect(QRectF(bx, by, bw, bh))

            if shape == "cross-dot":
                dot_r = (thickness / 2.0) if thickness > 2 else 1.5
                if outline > 0:
                    painter.setPen(Qt.PenStyle.NoPen)
                    painter.setBrush(QBrush(out_col))
                    painter.drawEllipse(QPointF(cx, cy), dot_r + outline, dot_r + outline)
                painter.setBrush(QBrush(col))
                painter.drawEllipse(QPointF(cx, cy), dot_r, dot_r)

        painter.setClipping(False)
        painter.setPen(QPen(QColor("#1f232d"), 1.0))
        painter.setBrush(Qt.BrushStyle.NoBrush)
        painter.drawRoundedRect(QRectF(0.5, 0.5, w - 1.0, h - 1.0), 8, 8)


class CrosshairApp(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Screen Crosshair")
        self.setFixedSize(480, 620)

        icon_path = os.path.expanduser("~/.local/share/icons/hicolor/scalable/apps/crosshair.svg")
        if os.path.exists(icon_path):
            self.setWindowIcon(QIcon(icon_path))

        self.cfg = load_config()
        self.updating_ui = False

        self.init_ui()

        self.status_timer = QTimer(self)
        self.status_timer.timeout.connect(self.update_status)
        self.status_timer.start(1000)
        self.update_status()

    def init_ui(self):
