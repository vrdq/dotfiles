#!/usr/bin/env python3
"""
crosshair-gui: configuration utility for Wayland crosshair-overlay daemon.
Controls reticle geometry, color, opacity, offsets, and monitor targeting.
"""

import os
import shutil
import subprocess
import sys
from pathlib import Path

from PyQt6.QtCore import QPointF, QRectF, Qt, QTimer
from PyQt6.QtGui import (
    QBrush, QColor, QFont, QGuiApplication, QIcon, QPainter, QPen
)
from PyQt6.QtWidgets import (
    QApplication, QColorDialog, QComboBox, QDialog, QDoubleSpinBox,
    QFormLayout, QFrame, QGridLayout, QGroupBox, QHBoxLayout, QLabel,
    QPushButton, QSlider, QSpinBox, QTabWidget, QVBoxLayout, QWidget
)

CONFIG_DIR = Path.home() / ".config" / "crosshair"
CONFIG_FILE = CONFIG_DIR / "config"

DEFAULT_CONFIG = {
    "shape": "dot",
    "size": 6.0,
    "color": "#00FF00",
    "outline": 1.0,
    "outline_color": "#000000",
    "opacity": 1.0,
    "offset_x": 0,
    "offset_y": 0,
    "gap": 3,
    "length": 7,
    "thickness": 2,
    "monitor": "all",
}

PRESETS = {
    "Custom": {},
    "Green Dot": {
        "shape": "dot", "size": 6.0, "color": "#00FF00", "outline": 1.0,
        "outline_color": "#000000", "opacity": 1.0, "offset_x": 0, "offset_y": 0
    },
    "Micro Dot": {
