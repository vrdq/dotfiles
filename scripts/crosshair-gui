        prev_layout.setAlignment(Qt.AlignmentFlag.AlignCenter)

        self.canvas = ReticleCanvas()
        self.canvas.set_config(self.cfg)
        prev_layout.addWidget(self.canvas, 0, Qt.AlignmentFlag.AlignCenter)

