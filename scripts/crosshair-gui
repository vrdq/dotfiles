        font_status.setBold(True)
        self.lbl_status.setFont(font_status)

        self.btn_toggle = QPushButton("Start Crosshair")
        self.btn_toggle.setObjectName("primaryBtn")
        self.btn_toggle.setMinimumWidth(130)
        self.btn_toggle.clicked.connect(self.on_toggle_clicked)

        self.btn_reload = QPushButton("Reload")
        self.btn_reload.setToolTip("Reload running daemon")
        self.btn_reload.clicked.connect(self.on_reload_clicked)

        status_bar.addWidget(self.lbl_status)
        status_bar.addStretch()
        status_bar.addWidget(self.btn_reload)
        status_bar.addWidget(self.btn_toggle)
        root.addLayout(status_bar)

