            self.bg_buttons[b_id] = btn
            bg_row.addWidget(btn)
        prev_layout.addLayout(bg_row)

        root.addWidget(preview_card)

        # -------------------------------------------------------------
        # 3. Preset Selector Pills
        # -------------------------------------------------------------
        presets_box = QHBoxLayout()
        presets_box.setSpacing(5)
        self.preset_buttons = {}
        for p_name in PRESETS.keys():
            btn = QPushButton(p_name)
            btn.setProperty("class", "chip")
            btn.clicked.connect(lambda _, n=p_name: self.apply_preset(n))
            self.preset_buttons[p_name] = btn
            presets_box.addWidget(btn)
        root.addLayout(presets_box)

        # -------------------------------------------------------------
        # 4. Settings Card (Sliders, Colors, Offsets)
        # -------------------------------------------------------------
        settings_card = QFrame()
        settings_card.setProperty("class", "panel")
        s_layout = QVBoxLayout(settings_card)
        s_layout.setContentsMargins(12, 10, 12, 10)
        s_layout.setSpacing(7)

        self.slider_size, self.badge_size = self.create_slider_row(
            s_layout, "Size", 2, 60, int(self.cfg.get("size", 6.0) * 2),
            lambda v: self.on_size_slider(v)
        )

        self.slider_outline, self.badge_outline = self.create_slider_row(
            s_layout, "Outline", 0, 30, int(self.cfg.get("outline", 1.0) * 10),
            lambda v: self.on_outline_slider(v)
        )

        self.slider_opacity, self.badge_opacity = self.create_slider_row(
            s_layout, "Opacity", 20, 100, int(self.cfg.get("opacity", 1.0) * 100),
            lambda v: self.on_opacity_slider(v)
        )

        # Color row
        color_row = QHBoxLayout()
        lbl_col = QLabel("Color")
        lbl_col.setProperty("class", "field-label")
        color_row.addWidget(lbl_col)
        color_row.addStretch()

        self.swatch_buttons = {}
        cur_col = self.cfg.get("color", "#00FF00").upper()
        for hex_val, name in COLOR_SWATCHES:
            swatch = QPushButton()
            swatch.setFixedSize(20, 20)
            swatch.setToolTip(name)
            self.swatch_buttons[hex_val.upper()] = swatch
            swatch.clicked.connect(lambda _, c=hex_val: self.set_color(c))
            color_row.addWidget(swatch)

        self.btn_custom = QPushButton(cur_col)
        self.btn_custom.setProperty("class", "btn-subtle")
        self.btn_custom.clicked.connect(self.choose_custom_color)
        color_row.addWidget(self.btn_custom)
        s_layout.addLayout(color_row)

        # Center Offsets
        offset_row = QHBoxLayout()
        lbl_pos = QLabel("Offset")
        lbl_pos.setProperty("class", "field-label")
        offset_row.addWidget(lbl_pos)
        offset_row.addStretch()

        self.slider_off_x = QSlider(Qt.Orientation.Horizontal)
        self.slider_off_x.setRange(-25, 25)
        self.slider_off_x.setValue(int(self.cfg.get("offset_x", 0)))
        self.slider_off_x.setFixedWidth(70)
        self.slider_off_x.valueChanged.connect(self.on_offset_changed)

        self.slider_off_y = QSlider(Qt.Orientation.Horizontal)
        self.slider_off_y.setRange(-25, 25)
        self.slider_off_y.setValue(int(self.cfg.get("offset_y", 0)))
        self.slider_off_y.setFixedWidth(70)
        self.slider_off_y.valueChanged.connect(self.on_offset_changed)

        self.badge_offset = QLabel(f"X:{self.cfg.get('offset_x', 0):+d} Y:{self.cfg.get('offset_y', 0):+d}")
        self.badge_offset.setProperty("class", "badge")

        btn_reset_pos = QPushButton("Center")
        btn_reset_pos.setProperty("class", "btn-subtle")
        btn_reset_pos.clicked.connect(self.reset_offsets)

        offset_row.addWidget(self.slider_off_x)
        offset_row.addWidget(self.slider_off_y)
        offset_row.addWidget(self.badge_offset)
        offset_row.addWidget(btn_reset_pos)
        s_layout.addLayout(offset_row)

        root.addWidget(settings_card)

        # -------------------------------------------------------------
        # 5. CS2 Command Helper Card
        # -------------------------------------------------------------
        cs2_card = QFrame()
        cs2_card.setProperty("class", "panel")
        cs2_layout = QHBoxLayout(cs2_card)
        cs2_layout.setContentsMargins(12, 7, 12, 7)

        cs2_info = QVBoxLayout()
        cs2_info.setSpacing(1)
        lbl_cs2 = QLabel("CS2 Crosshair Command")
        lbl_cs2.setStyleSheet("font-size: 11px; font-weight: 600; color: #a1a1aa;")
        lbl_cs2_sub = QLabel("cl_crosshairalpha 0; cl_crosshair_drawoutline 0")
        lbl_cs2_sub.setStyleSheet("font-size: 11px; font-family: monospace; color: #34d399;")
        cs2_info.addWidget(lbl_cs2)
        cs2_info.addWidget(lbl_cs2_sub)
        cs2_layout.addLayout(cs2_info)

        cs2_layout.addStretch()

        btn_copy_cs2 = QPushButton("Copy")
        btn_copy_cs2.setProperty("class", "btn-subtle")
        btn_copy_cs2.clicked.connect(lambda: self.copy_text("cl_crosshairalpha 0; cl_crosshair_drawoutline 0", btn_copy_cs2))
        cs2_layout.addWidget(btn_copy_cs2)

        root.addWidget(cs2_card)

        self.sync_widgets()

    def create_slider_row(self, parent_layout, label_text, min_v, max_v, init_v, on_change):
        row = QHBoxLayout()
        row.setSpacing(8)

        lbl = QLabel(label_text)
        lbl.setProperty("class", "field-label")
        lbl.setFixedWidth(55)
        row.addWidget(lbl)

        slider = QSlider(Qt.Orientation.Horizontal)
        slider.setRange(min_v, max_v)
        slider.setValue(init_v)
        slider.valueChanged.connect(on_change)
        row.addWidget(slider)

        badge = QLabel("0.0 px")
        badge.setProperty("class", "badge")
        badge.setFixedWidth(50)
        badge.setAlignment(Qt.AlignmentFlag.AlignCenter)
        row.addWidget(badge)

        parent_layout.addLayout(row)
        return slider, badge

    def set_bg(self, mode):
        self.canvas.set_bg_mode(mode)
        for b_id, btn in self.bg_buttons.items():
            btn.setProperty("class", "btn-subtle-active" if b_id == mode else "btn-subtle")
            btn.style().unpolish(btn)
            btn.style().polish(btn)

    def on_size_slider(self, val):
        if self.updating_ui: return
        sz = val / 2.0
        self.cfg["size"] = sz
        self.badge_size.setText(f"{sz:.1f} px")
        self.commit()

    def on_outline_slider(self, val):
        if self.updating_ui: return
        ot = val / 10.0
        self.cfg["outline"] = ot
        self.badge_outline.setText(f"{ot:.1f} px")
        self.commit()

    def on_opacity_slider(self, val):
        if self.updating_ui: return
        self.cfg["opacity"] = val / 100.0
        self.badge_opacity.setText(f"{val}%")
        self.commit()

    def on_offset_changed(self):
        if self.updating_ui: return
        ox = self.slider_off_x.value()
        oy = self.slider_off_y.value()
        self.cfg["offset_x"] = ox
        self.cfg["offset_y"] = oy
        self.badge_offset.setText(f"X:{ox:+d} Y:{oy:+d}")
        self.commit()

    def reset_offsets(self):
        self.updating_ui = True
        self.slider_off_x.setValue(0)
        self.slider_off_y.setValue(0)
        self.cfg["offset_x"] = 0
        self.cfg["offset_y"] = 0
        self.badge_offset.setText("X:+0 Y:+0")
        self.updating_ui = False
        self.commit()

    def set_color(self, hex_val):
        self.cfg["color"] = hex_val.upper()
        self.btn_custom.setText(hex_val.upper())
        self.update_swatch_styles()
        self.commit()

    def update_swatch_styles(self):
        cur_col = self.cfg.get("color", "#00FF00").upper()
        for hex_val, btn in self.swatch_buttons.items():
            is_active = (hex_val == cur_col)
            border = "2px solid #059669" if is_active else "1px solid #272c38"
            btn.setStyleSheet(f"""
                QPushButton {{
                    background-color: {hex_val};
                    border: {border};
                    border-radius: 10px;
                }}
                QPushButton:hover {{
                    border: 2px solid #34d399;
                }}
            """)

    def choose_custom_color(self):
        cur = QColor(self.cfg.get("color", "#00FF00"))
        col = QColorDialog.getColor(cur, self, "Select Reticle Color")
        if col.isValid():
            self.set_color(col.name().upper())

    def apply_preset(self, name):
        if name not in PRESETS: return
        self.cfg.update(PRESETS[name])
        self.sync_widgets()
        self.commit()

    def sync_widgets(self):
        self.updating_ui = True

        sz = float(self.cfg.get("size", 6.0))
        self.slider_size.setValue(int(sz * 2))
        self.badge_size.setText(f"{sz:.1f} px")

        ot = float(self.cfg.get("outline", 1.0))
        self.slider_outline.setValue(int(ot * 10))
        self.badge_outline.setText(f"{ot:.1f} px")

        op = float(self.cfg.get("opacity", 1.0))
        self.slider_opacity.setValue(int(op * 100))
        self.badge_opacity.setText(f"{int(op * 100)}%")

        ox = int(self.cfg.get("offset_x", 0))
        oy = int(self.cfg.get("offset_y", 0))
        self.slider_off_x.setValue(ox)
        self.slider_off_y.setValue(oy)
        self.badge_offset.setText(f"X:{ox:+d} Y:{oy:+d}")

        cur_shape = self.cfg.get("shape", "dot")
        for p_name, p_btn in self.preset_buttons.items():
            preset_data = PRESETS[p_name]
            is_match = (preset_data.get("shape") == cur_shape and
                        abs(preset_data.get("size", 0) - sz) < 0.2)
            if is_match:
                p_btn.setProperty("class", "chip-active")
            else:
                p_btn.setProperty("class", "chip")
            p_btn.style().unpolish(p_btn)
            p_btn.style().polish(p_btn)

        self.update_swatch_styles()
        self.canvas.set_config(self.cfg)
        self.updating_ui = False

    def commit(self):
        self.canvas.set_config(self.cfg)
        save_config(self.cfg)

    def update_status(self):
        is_running, pid = get_process_status()
        if is_running:
            self.lbl_status.setText(f"Running (PID {pid})")
            self.lbl_status.setProperty("class", "status-active")
            self.btn_toggle.setText("Disable")
            self.btn_toggle.setProperty("class", "btn-disable")
        else:
            self.lbl_status.setText("Inactive")
            self.lbl_status.setProperty("class", "status-inactive")
            self.btn_toggle.setText("Enable")
            self.btn_toggle.setProperty("class", "btn-enable")

        self.lbl_status.style().unpolish(self.lbl_status)
        self.lbl_status.style().polish(self.lbl_status)
        self.btn_toggle.style().unpolish(self.btn_toggle)
        self.btn_toggle.style().polish(self.btn_toggle)

    def on_toggle_clicked(self):
        subprocess.run(["crosshair", "toggle"])
        QTimer.singleShot(250, self.update_status)

    def copy_text(self, text, button):
        QApplication.clipboard().setText(text)
        orig = button.text()
        button.setText("Copied")
        QTimer.singleShot(1200, lambda: button.setText(orig))


def main():
    app = QApplication(sys.argv)
    app.setDesktopFileName("crosshair")

    # Global Dark Palette
    palette = QPalette()
    palette.setColor(QPalette.ColorRole.Window, QColor("#0b0c10"))
    palette.setColor(QPalette.ColorRole.WindowText, QColor("#d4d4d8"))
    palette.setColor(QPalette.ColorRole.Base, QColor("#12141a"))
    palette.setColor(QPalette.ColorRole.AlternateBase, QColor("#181b24"))
    palette.setColor(QPalette.ColorRole.ToolTipBase, QColor("#12141a"))
    palette.setColor(QPalette.ColorRole.ToolTipText, QColor("#f4f4f5"))
    palette.setColor(QPalette.ColorRole.Text, QColor("#e4e4e7"))
    palette.setColor(QPalette.ColorRole.Button, QColor("#14171f"))
    palette.setColor(QPalette.ColorRole.ButtonText, QColor("#d4d4d8"))
    palette.setColor(QPalette.ColorRole.BrightText, QColor("#ffffff"))
    palette.setColor(QPalette.ColorRole.Highlight, QColor("#059669"))
    palette.setColor(QPalette.ColorRole.HighlightedText, QColor("#ffffff"))
    app.setPalette(palette)

    win = CrosshairApp()
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
