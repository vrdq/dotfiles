        self.combo_monitor = QComboBox()
        self.combo_monitor.addItem("All Monitors", "all")
        screens = QGuiApplication.screens()
        for s in screens:
            name = s.name()
            if name:
                self.combo_monitor.addItem(f"{name} ({s.geometry().width()}x{s.geometry().height()})", name)
        self.combo_monitor.currentIndexChanged.connect(self.on_monitor_changed)
        form_pos.addRow("Display Target:", self.combo_monitor)

        tabs.addTab(tab_pos, "Position")
        root.addWidget(tabs)

        # Close button
        bottom_bar = QHBoxLayout()
        bottom_bar.addStretch()
        btn_close = QPushButton("Close")
        btn_close.clicked.connect(self.close)
        bottom_bar.addWidget(btn_close)
        root.addLayout(bottom_bar)

        self.sync_widgets_from_config()

    def sync_widgets_from_config(self):
        self.updating_ui = True

        shape = self.cfg.get("shape", "dot")
        idx = self.combo_shape.findData(shape)
        if idx >= 0:
            self.combo_shape.setCurrentIndex(idx)

        sz = float(self.cfg.get("size", 6.0))
        self.spin_size.setValue(sz)
        self.slider_size.setValue(int(sz * 2))

        gap = int(self.cfg.get("gap", 3))
        self.spin_gap.setValue(gap)
        self.slider_gap.setValue(gap)

        length = int(self.cfg.get("length", 7))
        self.spin_length.setValue(length)
        self.slider_length.setValue(length)

        thick = int(self.cfg.get("thickness", 2))
        self.spin_thick.setValue(thick)
        self.slider_thick.setValue(thick)

        ot = float(self.cfg.get("outline", 1.0))
        self.spin_outline.setValue(ot)
        self.slider_outline.setValue(int(ot * 10))

        op = float(self.cfg.get("opacity", 1.0))
        self.spin_opacity.setValue(int(op * 100))
        self.slider_opacity.setValue(int(op * 100))

        self.spin_off_x.setValue(int(self.cfg.get("offset_x", 0)))
        self.spin_off_y.setValue(int(self.cfg.get("offset_y", 0)))

        mon = self.cfg.get("monitor", "all")
        m_idx = self.combo_monitor.findData(mon)
        if m_idx >= 0:
            self.combo_monitor.setCurrentIndex(m_idx)

        self.update_color_swatches()
        self.update_shape_visibility(shape)
        self.canvas.set_config(self.cfg)
        self.updating_ui = False

    def update_shape_visibility(self, shape):
        """Show or dim controls according to selected reticle shape."""
        is_cross = shape in ("cross", "cross-dot")
        is_ring = shape in ("ring", "dot-ring")

        self.slider_gap.setEnabled(is_cross)
        self.spin_gap.setEnabled(is_cross)
        self.gap_row_label.setEnabled(is_cross)

        self.slider_length.setEnabled(is_cross)
        self.spin_length.setEnabled(is_cross)
        self.len_row_label.setEnabled(is_cross)

        self.slider_thick.setEnabled(is_cross or is_ring)
        self.spin_thick.setEnabled(is_cross or is_ring)
        self.thick_row_label.setEnabled(is_cross or is_ring)

    def update_color_swatches(self):
        col = self.cfg.get("color", "#00FF00").upper()
        self.lbl_color_hex.setText(col)
        self.lbl_color_swatch.setStyleSheet(f"background-color: {col}; border: 1px solid #444; border-radius: 2px;")

        out_col = self.cfg.get("outline_color", "#000000").upper()
        self.lbl_out_color_hex.setText(out_col)
        self.lbl_out_color_swatch.setStyleSheet(f"background-color: {out_col}; border: 1px solid #444; border-radius: 2px;")

    def on_bg_changed(self, idx):
        modes = ["dark", "light", "checker"]
        self.canvas.set_bg_mode(modes[idx])

    def on_preset_selected(self, name):
        if self.updating_ui or name not in PRESETS or name == "Custom":
            return
        self.cfg.update(PRESETS[name])
        self.sync_widgets_from_config()
        self.commit()

    def on_shape_changed(self, idx):
        if self.updating_ui:
            return
        shape = self.combo_shape.currentData()
        self.cfg["shape"] = shape
        self.update_shape_visibility(shape)
        self.combo_preset.setCurrentText("Custom")
        self.commit()

    def on_slider_size(self, val):
        if self.updating_ui: return
        self.updating_ui = True
        sz = val / 2.0
        self.spin_size.setValue(sz)
        self.cfg["size"] = sz
        self.combo_preset.setCurrentText("Custom")
        self.updating_ui = False
        self.commit()

    def on_spin_size(self, val):
        if self.updating_ui: return
        self.updating_ui = True
        self.slider_size.setValue(int(val * 2))
        self.cfg["size"] = val
        self.combo_preset.setCurrentText("Custom")
        self.updating_ui = False
        self.commit()

    def on_slider_gap(self, val):
        if self.updating_ui: return
        self.updating_ui = True
        self.spin_gap.setValue(val)
        self.cfg["gap"] = val
        self.combo_preset.setCurrentText("Custom")
        self.updating_ui = False
        self.commit()

    def on_spin_gap(self, val):
        if self.updating_ui: return
        self.updating_ui = True
        self.slider_gap.setValue(val)
        self.cfg["gap"] = val
        self.combo_preset.setCurrentText("Custom")
        self.updating_ui = False
        self.commit()

    def on_slider_length(self, val):
        if self.updating_ui: return
        self.updating_ui = True
        self.spin_length.setValue(val)
        self.cfg["length"] = val
        self.combo_preset.setCurrentText("Custom")
        self.updating_ui = False
        self.commit()

    def on_spin_length(self, val):
        if self.updating_ui: return
        self.updating_ui = True
        self.slider_length.setValue(val)
        self.cfg["length"] = val
        self.combo_preset.setCurrentText("Custom")
        self.updating_ui = False
        self.commit()

    def on_slider_thick(self, val):
        if self.updating_ui: return
        self.updating_ui = True
        self.spin_thick.setValue(val)
        self.cfg["thickness"] = val
        self.combo_preset.setCurrentText("Custom")
        self.updating_ui = False
        self.commit()

    def on_spin_thick(self, val):
        if self.updating_ui: return
        self.updating_ui = True
        self.slider_thick.setValue(val)
        self.cfg["thickness"] = val
        self.combo_preset.setCurrentText("Custom")
        self.updating_ui = False
        self.commit()

    def on_slider_outline(self, val):
        if self.updating_ui: return
        self.updating_ui = True
        ot = val / 10.0
        self.spin_outline.setValue(ot)
        self.cfg["outline"] = ot
        self.combo_preset.setCurrentText("Custom")
        self.updating_ui = False
        self.commit()

    def on_spin_outline(self, val):
        if self.updating_ui: return
        self.updating_ui = True
        self.slider_outline.setValue(int(val * 10))
        self.cfg["outline"] = val
        self.combo_preset.setCurrentText("Custom")
        self.updating_ui = False
        self.commit()

    def on_slider_opacity(self, val):
        if self.updating_ui: return
        self.updating_ui = True
        self.spin_opacity.setValue(val)
        self.cfg["opacity"] = val / 100.0
        self.combo_preset.setCurrentText("Custom")
        self.updating_ui = False
        self.commit()

    def on_spin_opacity(self, val):
        if self.updating_ui: return
        self.updating_ui = True
        self.slider_opacity.setValue(val)
        self.cfg["opacity"] = val / 100.0
        self.combo_preset.setCurrentText("Custom")
        self.updating_ui = False
        self.commit()

    def on_offset_changed(self):
        if self.updating_ui: return
        self.cfg["offset_x"] = self.spin_off_x.value()
        self.cfg["offset_y"] = self.spin_off_y.value()
        self.combo_preset.setCurrentText("Custom")
        self.commit()

    def on_monitor_changed(self):
        if self.updating_ui: return
        self.cfg["monitor"] = self.combo_monitor.currentData()
        self.commit()

    def reset_offsets(self):
        self.updating_ui = True
        self.spin_off_x.setValue(0)
        self.spin_off_y.setValue(0)
        self.cfg["offset_x"] = 0
        self.cfg["offset_y"] = 0
        self.combo_preset.setCurrentText("Custom")
        self.updating_ui = False
        self.commit()

    def choose_color(self):
        cur = QColor(self.cfg.get("color", "#00FF00"))
        col = QColorDialog.getColor(cur, self, "Select Reticle Color")
        if col.isValid():
            self.cfg["color"] = col.name().upper()
            self.update_color_swatches()
            self.combo_preset.setCurrentText("Custom")
            self.commit()

    def choose_outline_color(self):
        cur = QColor(self.cfg.get("outline_color", "#000000"))
        col = QColorDialog.getColor(cur, self, "Select Outline Color")
        if col.isValid():
            self.cfg["outline_color"] = col.name().upper()
            self.update_color_swatches()
            self.combo_preset.setCurrentText("Custom")
            self.commit()

    def commit(self):
        self.canvas.set_config(self.cfg)
        save_config(self.cfg)

    def update_status(self):
        is_running, pid = get_process_status()
        if is_running:
            self.lbl_status.setText(f"Status: Running (PID {pid})")
            self.lbl_status.setStyleSheet("color: #9bff7f;")
            self.btn_toggle.setText("Stop Overlay")
            self.btn_toggle.setObjectName("stopBtn")
            self.btn_toggle.setStyle(self.btn_toggle.style())
        else:
            self.lbl_status.setText("Status: Inactive")
            self.lbl_status.setStyleSheet("color: #888888;")
            self.btn_toggle.setText("Start Overlay")
            self.btn_toggle.setObjectName("primaryBtn")
            self.btn_toggle.setStyle(self.btn_toggle.style())

    def on_toggle_clicked(self):
        bin_path = find_crosshair_bin()
        subprocess.run([bin_path, "toggle"])
        QTimer.singleShot(250, self.update_status)

    def on_reload_clicked(self):
        bin_path = find_crosshair_bin()
        subprocess.run([bin_path, "reload"])
        self.update_status()


def main():
    app = QApplication(sys.argv)
    app.setDesktopFileName("crosshair")
    win = CrosshairSettingsDialog()
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
