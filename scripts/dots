#!/usr/bin/env bash
# ==============================================================================
# dots — Official Dotfiles & Rice Management CLI
# ==============================================================================

set -euo pipefail

# Visual styling
BOLD='\033[1m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
DIM='\033[2m'
NC='\033[0m'

DOTFILES_DIR="$HOME/dotfiles"

print_header() {
    cat << "EOF"
  __   __ ___  ___   ___     ___   ___  _____ ___ ___ _    ___ ___ 
  \ \ / /| _ \|   \ / _ \ / __|   |   \ / _ \|_   _| __|_ _| |  | __/ __|
   \ V / |   /| |) | (_) |\__ \   | |) | (_) | | | | _| | || |__| _|\__ \
    \_/  |_|_\|___/ \__\_\|___/   |___/ \___/  |_| |_| |___|____|___|___/
EOF
    echo -e "${CYAN}Dotfiles & Rice Manager${NC} ${DIM}•${NC} ${BLUE}https://github.com/vrdq/dotfiles${NC}\n"
}

show_help() {
    print_header
    cat << EOF
${BOLD}Usage:${NC} dots <command> [arguments]

${BOLD}Commands:${NC}
  ${GREEN}status${NC}             Show current rice status, git state, monitors & theme
  ${GREEN}update${NC}             Fast update: pull latest git commits, re-template & reload
  ${GREEN}doctor${NC}             Run system health check (symlinks, fonts, tools, portals)
  ${GREEN}optimize${NC}           Apply gaming kernel sysctl tweaks and clean caches
  ${GREEN}reload${NC}             Hot-reload Hyprland configuration and restart DMS shell
  ${GREEN}push${NC} [message]     Stage all rice modifications, commit, and push to GitHub
  ${GREEN}backup${NC}             Create an instant snapshot backup in ~/.dotfiles-backup/
  ${GREEN}help${NC}               Show this help message
EOF
}

cmd_status() {
    print_header
    echo -e "${BOLD}Repository Status:${NC}"
    if [ -d "$DOTFILES_DIR/.git" ]; then
        local branch="$(git -C "$DOTFILES_DIR" branch --show-current 2>/dev/null || echo "detached")"
        local commit="$(git -C "$DOTFILES_DIR" log -1 --format="%h - %s (%cr)" 2>/dev/null || echo "unknown")"
        echo -e "  Branch: ${CYAN}$branch${NC}"
        echo -e "  Commit: ${DIM}$commit${NC}"
        local changes="$(git -C "$DOTFILES_DIR" status --porcelain 2>/dev/null || true)"
        if [ -z "$changes" ]; then
            echo -e "  Working Tree: ${GREEN}clean (up to date)${NC}"
        else
            echo -e "  Working Tree: ${YELLOW}modified files present${NC}"
        fi
    else
        echo -e "  ${RED}Not a git repository: $DOTFILES_DIR${NC}"
    fi

    echo -e "\n${BOLD}Display & Session Status:${NC}"
    if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" -o -d "/run/user/$(id -u)/hypr" ]; then
        export HYPRLAND_INSTANCE_SIGNATURE="${HYPRLAND_INSTANCE_SIGNATURE:-$(ls -td /run/user/$(id -u)/hypr/* 2>/dev/null | head -1 | xargs basename 2>/dev/null || true)}"
        echo -e "  Compositor: ${GREEN}Hyprland (active)${NC}"
        if hyprctl monitors >/dev/null 2>&1; then
            while IFS= read -r line; do
                echo -e "  $line"
            done < <(hyprctl monitors | grep -E "Monitor [a-zA-Z0-9-]+|description:|[0-9]+x[0-9]+@[0-9.]+Hz")
        fi
    else
        echo -e "  Compositor: ${YELLOW}Hyprland not currently running${NC}"
    fi

    echo -e "\n${BOLD}Shell & Theme Status:${NC}"
    if pgrep -f "dms run" >/dev/null 2>&1; then
        echo -e "  DankMaterialShell: ${GREEN}running${NC}"
    else
        echo -e "  DankMaterialShell: ${YELLOW}stopped${NC}"
    fi
    echo -e "  GTK Theme: ${CYAN}$(grep -E '^gtk-theme-name=' "$HOME/.config/gtk-3.0/settings.ini" 2>/dev/null | cut -d'=' -f2 || echo "Breeze-Dark")${NC}"
    echo -e "  Cursor: ${CYAN}$(grep -E '^gtk-cursor-theme-name=' "$HOME/.config/gtk-3.0/settings.ini" 2>/dev/null | cut -d'=' -f2 || echo "Bibata-Modern-Classic")${NC}"
    echo -e "  Icons: ${CYAN}$(grep -E '^Theme=' "$HOME/.config/kdeglobals" 2>/dev/null | cut -d'=' -f2 || echo "BreezeDarkMonochrome")${NC}"
    echo ""
}

cmd_reload() {
    echo -e "${CYAN}Reloading Hyprland and DankMaterialShell...${NC}"
    if command -v hyprctl >/dev/null 2>&1; then
        hyprctl reload >/dev/null 2>&1 || true
        echo -e "  [${GREEN}✓${NC}] Hyprland reloaded"
    fi
    if command -v dms >/dev/null 2>&1; then
        dms restart >/dev/null 2>&1 || true
        echo -e "  [${GREEN}✓${NC}] DankMaterialShell restarted"
    fi
    echo -e "${GREEN}Desktop refreshed successfully.${NC}\n"
}

cmd_update() {
    print_header
    echo -e "${BOLD}Updating dotfiles from GitHub...${NC}"
    if [ ! -d "$DOTFILES_DIR/.git" ]; then
        echo -e "${RED}Error: $DOTFILES_DIR is not a git repository.${NC}"
        exit 1
    fi

    cd "$DOTFILES_DIR"
    git pull origin main

    echo -e "\n${BOLD}Re-deploying configuration files...${NC}"
    "$DOTFILES_DIR/install.sh" -y --update 2>/dev/null || "$DOTFILES_DIR/install.sh" -y

    cmd_reload
}

cmd_doctor() {
    print_header
    echo -e "${BOLD}Running Rice Diagnostics...${NC}\n"
    local issues=0

    check_item() {
        local name="$1"
        local cmd="$2"
        local status=0
        (
            set +o pipefail
            eval "$cmd" >/dev/null 2>&1
        ) || status=$?
        if [ "$status" -eq 0 ]; then
            echo -e "  [${GREEN}PASS${NC}] $name"
        else
            echo -e "  [${RED}FAIL${NC}] $name"
            issues=$((issues + 1))
        fi
    }

    echo -e "${BOLD}Core Binaries & Shell:${NC}"
    check_item "Hyprland compositor" "command -v hyprland"
    check_item "DankMaterialShell binary" "command -v dms"
    check_item "Kitty terminal" "command -v kitty"
    check_item "Fish shell" "command -v fish"
    check_item "Fastfetch system info" "command -v fastfetch"
    check_item "Dolphin file manager" "command -v dolphin"
    check_item "Gwenview image viewer" "command -v gwenview"

    echo -e "\n${BOLD}Wayland Utilities & Portals:${NC}"
    check_item "wl-clipboard (clipboard daemon)" "command -v wl-copy"
    check_item "grim (screenshot utility)" "command -v grim"
    check_item "slurp (region selector)" "command -v slurp"
    check_item "jq (JSON processor)" "command -v jq"
    check_item "xdg-desktop-portal-hyprland" "systemctl --user is-active --quiet xdg-desktop-portal-hyprland 2>/dev/null || pacman -Q xdg-desktop-portal-hyprland"

    echo -e "\n${BOLD}Theming, Icons & Fonts:${NC}"
    check_item "JetBrains Mono font" "fc-list : family | grep -qi 'JetBrains Mono'"
    check_item "BreezeDarkMonochrome icons" "[ -d '$HOME/.local/share/icons/BreezeDarkMonochrome' -o -d '/usr/share/icons/BreezeDarkMonochrome' ]"
    check_item "Bibata-Modern-Classic cursors" "[ -d '$HOME/.local/share/icons/Bibata-Modern-Classic' -o -d '/usr/share/icons/Bibata-Modern-Classic' ]"
    check_item "PrismLauncher Oxocarbon theme" "[ -d '$HOME/.local/share/PrismLauncher/themes/oxocarbon' ]"

    echo -e "\n${BOLD}Gaming & Performance Helpers:${NC}"
    check_item "Gamemode daemon" "command -v gamemoded || pacman -Q gamemode"
    check_item "game-run launcher" "command -v game-run || [ -x '$HOME/.local/bin/game-run' ]"
    check_item "Crosshair overlay binary" "command -v crosshair || [ -x '$HOME/.local/bin/crosshair' ]"

    echo ""
    if [ "$issues" -eq 0 ]; then
        echo -e "${GREEN}${BOLD}✓ All checks passed! The rice is in perfect health.${NC}\n"
    else
        echo -e "${YELLOW}${BOLD}Found $issues issue(s). Run 'dots update' or 'install.sh' to repair missing components.${NC}\n"
    fi
}

cmd_optimize() {
    print_header
    echo -e "${BOLD}Applying Gaming & Low-Latency Kernel Optimizations...${NC}\n"

    # 1. Sysctl gaming parameters
    local sysctl_file="/etc/sysctl.d/99-dotfiles-gaming.conf"
    echo -e "  [${CYAN}sysctl${NC}] Configuring low-latency gaming parameters..."
    sudo tee "$sysctl_file" >/dev/null << 'SYSCTL_EOF'
# Dotfiles Gaming & Responsiveness Optimizations
vm.max_map_count = 2147483642
vm.swappiness = 100
vm.vfs_cache_pressure = 50
vm.page-cluster = 0
vm.watermark_boost_factor = 0
vm.watermark_scale_factor = 125
fs.file-max = 2097152
net.core.default_qdisc = cake
net.ipv4.tcp_congestion_control = bbr
net.ipv4.tcp_fastopen = 3
SYSCTL_EOF
    sudo sysctl -p "$sysctl_file" >/dev/null 2>&1 || true
    echo -e "  [${GREEN}✓${NC}] Sysctl parameters applied"

    # 2. Pacman cache maintenance
    if command -v pacman >/dev/null 2>&1; then
        echo -e "  [${CYAN}cache${NC}] Cleaning accumulated package caches..."
        if command -v paccache >/dev/null 2>&1; then
            sudo paccache -rk1 >/dev/null 2>&1 || true
            sudo paccache -ruk0 >/dev/null 2>&1 || true
            sudo systemctl enable --now paccache.timer >/dev/null 2>&1 || true
            echo -e "  [${GREEN}✓${NC}] Package cache trimmed & automatic weekly timer enabled"
        fi
    fi

    # 3. Power profile
    if command -v powerprofilesctl >/dev/null 2>&1; then
        powerprofilesctl set performance 2>/dev/null || true
        echo -e "  [${GREEN}✓${NC}] Power profile set to performance"
    fi

    echo -e "\n${GREEN}${BOLD}✓ Optimizations completed successfully!${NC}\n"
}

cmd_push() {
    local msg="${1:-"refine(rice): update configurations from dots CLI"}"
    echo -e "${CYAN}Staging and pushing changes to origin main...${NC}"
    cd "$DOTFILES_DIR"
    git add .
    if git diff --staged --quiet; then
        echo -e "${YELLOW}No changes to commit.${NC}"
        return
    fi
    git commit -m "$msg"
    git push origin main
    echo -e "${GREEN}✓ Pushed successfully!${NC}\n"
}

cmd_backup() {
    local bdir="$HOME/.dotfiles-backup/manual-$(date +%Y%m%d_%H%M%S)"
    mkdir -p "$bdir"
    echo -e "${CYAN}Backing up active configurations to $bdir...${NC}"
    cp -a "$HOME/.config" "$bdir/" 2>/dev/null || true
    echo -e "${GREEN}✓ Backup completed!${NC}\n"
}

# Subcommand dispatch
SUBCMD="${1:-"status"}"
shift || true

case "$SUBCMD" in
    status)   cmd_status "$@" ;;
    update)   cmd_update "$@" ;;
    doctor)   cmd_doctor "$@" ;;
    reload)   cmd_reload "$@" ;;
    optimize) cmd_optimize "$@" ;;
    push)     cmd_push "$@" ;;
    backup)   cmd_backup "$@" ;;
    help|-h|--help) show_help ;;
    *)
        echo -e "${RED}Unknown command: $SUBCMD${NC}"
        show_help
        exit 1
        ;;
esac
